pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'anishaflipkart27/flipkart_shopping_app:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %DOCKER_IMAGE% .'
            }
        }

        stage('Test Docker Hub Login') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'dockerhub-token-secret',
                        variable: 'DOCKER_TOKEN'
                    )
                ]) {
                    bat '''
                        @echo off
                        docker logout >nul 2>&1
                        echo %DOCKER_TOKEN% | docker login --username anishaflipkart27 --password-stdin

                        if errorlevel 1 (
                            echo Docker Hub login failed.
                            exit /b 1
                        )

                        echo Docker Hub login succeeded.
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                bat '''
                    @echo off
                    docker push %DOCKER_IMAGE%

                    if errorlevel 1 (
                        echo Docker image push failed.
                        exit /b 1
                    )

                    echo Docker image pushed successfully.
                    docker logout
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Docker image pushed to Docker Hub.'
        }

        failure {
            echo 'FAILED: Check Console Output for the exact error.'
        }

        always {
            bat 'docker logout'
        }
    }
}
