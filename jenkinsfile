pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'anishaflipkart27/flipkart_shopping_app'
        DOCKER_TAG   = 'latest'
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                checkout scm
            }
        }

        stage('Verify Docker') {
            steps {
                bat '''
                    @echo off
                    docker --version
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    @echo off
                    docker build -t %DOCKER_IMAGE%:%DOCKER_TAG% .
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'dockerhub-token-secret',
                        variable: 'DOCKER_TOKEN'
                    )
                ]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        $token = [string]$env:DOCKER_TOKEN
                        if ([string]::IsNullOrWhiteSpace($token)) {
                            throw "Docker Hub token is empty."
                        }

                        $dockerCommand = Get-Command docker.exe -ErrorAction SilentlyContinue
                        if (-not $dockerCommand) {
                            $dockerCommand = Get-Command docker -ErrorAction Stop
                        }

                        $dockerPath = $dockerCommand.Source

                        $dockerConfigPath = Join-Path $env:WORKSPACE ".docker-config"
                        New-Item -ItemType Directory -Force -Path $dockerConfigPath | Out-Null
                        $env:DOCKER_CONFIG = $dockerConfigPath

                        Write-Host "Docker executable: $dockerPath"
                        Write-Host "Starting Docker Hub login..."

                        $startInfo = New-Object System.Diagnostics.ProcessStartInfo
                        $startInfo.FileName = $dockerPath
                        $startInfo.Arguments = "login --username anishaflipkart27 --password-stdin"
                        $startInfo.UseShellExecute = $false
                        $startInfo.RedirectStandardInput = $true
                        $startInfo.RedirectStandardOutput = $true
                        $startInfo.RedirectStandardError = $true
                        $startInfo.CreateNoWindow = $true

                        $startInfo.EnvironmentVariables["DOCKER_CONFIG"] = $dockerConfigPath

                        $process = New-Object System.Diagnostics.Process
                        $process.StartInfo = $startInfo

                        if (-not $process.Start()) {
                            throw "Could not start Docker login."
                        }

                        $stdoutTask = $process.StandardOutput.ReadToEndAsync()
                        $stderrTask = $process.StandardError.ReadToEndAsync()

                        $utf8 = New-Object System.Text.UTF8Encoding($false)
                        $tokenBytes = $utf8.GetBytes($token.Trim() + "`n")

                        $process.StandardInput.BaseStream.Write(
                            $tokenBytes,
                            0,
                            $tokenBytes.Length
                        )
                        $process.StandardInput.Close()
                        $process.WaitForExit()

                        $stdout = $stdoutTask.Result
                        $stderr = $stderrTask.Result

                        if ($stdout) {
                            Write-Host $stdout
                        }

                        if ($process.ExitCode -ne 0) {
                            if ($stderr) {
                                Write-Host $stderr
                            }
                            throw "Docker Hub login failed with exit code $($process.ExitCode)."
                        }

                        Write-Host "Docker Hub login succeeded."
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Stop"

                    $dockerCommand = Get-Command docker.exe -ErrorAction SilentlyContinue
                    if (-not $dockerCommand) {
                        $dockerCommand = Get-Command docker -ErrorAction Stop
                    }

                    $env:DOCKER_CONFIG = Join-Path $env:WORKSPACE ".docker-config"

                    & $dockerCommand.Source push "$env:DOCKER_IMAGE`:$env:DOCKER_TAG"

                    if ($LASTEXITCODE -ne 0) {
                        throw "Docker image push failed."
                    }
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Docker image built and pushed to Docker Hub.'
        }

        failure {
            echo 'FAILED: Check Console Output for the failing stage.'
        }

        always {
            powershell '''
                $dockerConfigPath = Join-Path $env:WORKSPACE ".docker-config"

                if (Test-Path $dockerConfigPath) {
                    $dockerCommand = Get-Command docker.exe -ErrorAction SilentlyContinue

                    if ($dockerCommand) {
                        $env:DOCKER_CONFIG = $dockerConfigPath
                        & $dockerCommand.Source logout
                    }

                    Remove-Item -Recurse -Force $dockerConfigPath -ErrorAction SilentlyContinue
                }
            '''
        }
    }
}
