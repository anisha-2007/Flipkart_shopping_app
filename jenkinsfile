pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'anishaflipkart27/flipkart_shopping_app'
        DOCKER_TAG   = 'latest'
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                checkout scm
            }
        }

        stage('Verify Docker') {
            steps {
                bat '''
                    @echo off
                    docker --version
                    if errorlevel 1 exit /b 1
                    docker info --format "{{.OperatingSystem}}"
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    @echo off
                    docker build -t %DOCKER_IMAGE%:%DOCKER_TAG% .
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'dockerhub-username-pat'
                    ) {
                        bat '''
                            @echo off
                            docker push %DOCKER_IMAGE%:%DOCKER_TAG%
                            if errorlevel 1 exit /b 1
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Docker image built and pushed to Docker Hub.'
        }

        failure {
            echo 'FAILED: Check Console Output for the failing stage.'
        }
    }
}
