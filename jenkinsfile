pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'anishaflipkart27/flipkart_shopping_app:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %DOCKER_IMAGE% .'
            }
        }

        stage('Verify Docker Image') {
            steps {
                bat 'docker images %DOCKER_IMAGE%'
            }
        }

        stage('Login and Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-pat-new',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        if ([string]::IsNullOrWhiteSpace($env:DOCKER_USER)) {
                            throw "Docker username is empty."
                        }

                        if ([string]::IsNullOrWhiteSpace($env:DOCKER_PASS)) {
                            throw "Docker token is empty."
                        }

                        Write-Host "Username received: $($env:DOCKER_USER)"
Write-Host "Password is empty: $([string]::IsNullOrEmpty($env:DOCKER_PASS))"

                        $token | docker login `
                            --username $env:DOCKER_USER `
                            --password-stdin

                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker Hub login failed."
                        }

                        docker push $env:DOCKER_IMAGE

                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker image push failed."
                        }

                        docker logout

                        if ($LASTEXITCODE -ne 0) {
                            Write-Host "Docker logout returned a non-zero exit code."
                        }
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Docker image pushed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the stage that reported the error.'
        }
    }
}
