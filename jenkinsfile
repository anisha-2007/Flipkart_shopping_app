pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'anishaflipkart27/flipkart_shopping_app:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %DOCKER_IMAGE% .'
            }
        }

        stage('Docker Hub Login and Push') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'dockerhub-token-secret',
                        variable: 'DOCKER_TOKEN'
                    )
                ]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        if ([string]::IsNullOrWhiteSpace($env:DOCKER_TOKEN)) {
                            throw "Jenkins Docker token is empty."
                        }

                        $token = $env:DOCKER_TOKEN.Trim()

                        Write-Host "Token length: $($token.Length)"

                        $token | docker login `
                            --username "anishaflipkart27" `
                            --password-stdin

                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker Hub login failed."
                        }

                        Write-Host "Docker Hub login succeeded."

                        docker push $env:DOCKER_IMAGE

                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker image push failed."
                        }

                        Write-Host "Docker image pushed successfully."

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Docker image pushed to Docker Hub.'
        }

        failure {
            echo 'FAILED: Check the Console Output for the exact error.'
        }
    }
}
